{
  "name": "issunsaki-wa-uso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "一寸先は嘘 — 視聴者参加型 読み合いゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:sfx": "node scripts/gen-sfx.mjs",
    "font": "node scripts/subset-font.mjs",
    "validate:rooms": "node scripts/validate-rooms.mjs",
    "images:manifest": "node scripts/image-manifest.mjs",
    "shots": "node tools/shot.mjs",
    "test": "node tools/test-moderation.mjs && node tools/test-composite.mjs && node tools/test-locale.mjs && node tools/test-wire.mjs && node tools/test-party.mjs",
    "sim": "node tools/sim10.mjs 38",
    "party": "partykit dev --port 1999",
    "test:live": "node tools/party-live.mjs && node tools/advisor-live.mjs /tmp"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "motion": "^11.11.17",
    "partykit": "^0.0.115",
    "partysocket": "^1.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^26.5.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
